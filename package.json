{
  "name": "melviz",
  "version": "0.0.0",
  "description": "Melviz APIs and Components",
  "repository": "https://github.com/melviz-org/melviz",
  "author": "William Siqueira",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "core/",
    "packages/*",
    "components/*",
    "webapp/",
    "examples/"
  ],
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "lodash": "^4.18.1",
    "axios": "^1.20.0",
    "immutable": "^5.1.9",
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "handlebars": "^4.7.9",
    "shell-quote": "^1.10.0",
    "tar": "^7.5.22",
    "websocket-driver": "^0.7.5",
    "minimatch": "^10.2.6",
    "socket.io-parser": "^4.2.7",
    "engine.io": "^6.6.9",
    "ws": "^8.21.3",
    "fast-uri": "^3.1.6",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.7.0",
    "js-yaml": "^4.3.2",
    "picomatch@^2": "^2.3.2",
    "picomatch@^4": "^4.0.7",
    "ajv@^8": "^8.20.0",
    "qs": "^6.16.0",
    "follow-redirects": "^1.16.0",
    "@babel/core@^7.23.9": "^7.29.7"
  },
  "scripts": {
    "build:prod": "yarn build:packages && yarn build:core:prod && yarn build:components && yarn build:webapp && yarn build:examples",
    "build": "yarn build:packages && yarn build:core && yarn build:components && yarn build:webapp",
    "build:packages": "yarn workspace @melviz/component-api run build && yarn workspace @melviz/component-echarts-base run build && yarn workspace @melviz/component-dev run build",
    "build:core": "cd core && mvn clean install -DskipTests -Psources",
    "build:core:prod": "cd core && mvn clean install -Dfull",
    "build:components": "yarn workspaces foreach -Apt --include '@melviz/component-*' --exclude '@melviz/component-api' --exclude '@melviz/component-dev' --exclude '@melviz/component-echarts-base' run build",
    "build:webapp": "yarn workspace @melviz/webapp run build",
    "build:examples": "yarn workspace @melviz/examples run build",
    "clean": "yarn workspaces foreach -Apt run clean || true && cd core && mvn clean || true",
    "test": "yarn workspaces foreach -Apt run test",
    "test:integration": "cd integration-tests && npx playwright test"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
